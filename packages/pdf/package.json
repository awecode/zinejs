{
  "name": "@zinejs/pdf",
  "version": "0.4.0",
  "description": "PDF content source for zinejs, powered by pdf.js.",
  "type": "module",
  "sideEffects": false,
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": ["flipbook", "pdf", "pdf.js", "page-flip", "viewer", "zinejs"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awecode/zinejs.git",
    "directory": "packages/pdf"
  },
  "homepage": "https://github.com/awecode/zinejs/tree/main/packages/pdf#readme",
  "bugs": "https://github.com/awecode/zinejs/issues",
  "files": ["dist"],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm typecheck && vitest run",
    "size": "pnpm build && size-limit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "pdfjs-dist": ">=4"
  },
  "peerDependencies": {
    "@zinejs/core": "workspace:^"
  },
  "devDependencies": {
    "@zinejs/core": "workspace:^"
  },
  "size-limit": [
    {
      "name": "pdf plugin (ESM, gzip, excl. pdf.js)",
      "path": "dist/index.js",
      "limit": "8 kB",
      "gzip": true
    }
  ]
}
