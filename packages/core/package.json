{
  "name": "@zinejs/core",
  "version": "0.9.2",
  "description": "Framework-agnostic flipbook engine with CSS and WebGL2 renderers and no dependencies.",
  "type": "module",
  "sideEffects": false,
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": [
    "flipbook",
    "page-flip",
    "pageflip",
    "book",
    "webgl",
    "viewer",
    "zinejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awecode/zinejs.git",
    "directory": "packages/core"
  },
  "homepage": "https://zinejs.com",
  "bugs": "https://github.com/awecode/zinejs/issues",
  "files": [
    "dist",
    "options.schema.json"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.js"
    },
    "./curls": {
      "types": "./dist/geometry/curls/index.d.ts",
      "import": "./dist/curls.js"
    },
    "./options.schema.json": "./options.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && UMD=1 vite build && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "embed-clip": "node scripts/embed-flip-clip.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm typecheck && vitest run",
    "size": "pnpm build && size-limit",
    "prepublishOnly": "pnpm build"
  },
  "size-limit": [
    {
      "name": "core (ESM, gzip, excl. lazy renderer chunks)",
      "path": "dist/index.js",
      "limit": "17 kB",
      "gzip": true
    },
    {
      "name": "CSS renderer chunk (lazy, gzip)",
      "path": "dist/cssRenderer-*.js",
      "limit": "12 kB",
      "gzip": true
    },
    {
      "name": "WebGL2 renderer chunk (lazy, gzip)",
      "path": "dist/webglRenderer-*.js",
      "limit": "12 kB",
      "gzip": true
    },
    {
      "name": "all importable curls (opt-in, gzip)",
      "path": "dist/curls.js",
      "limit": "2.5 kB",
      "gzip": true
    },
    {
      "name": "controls chunk (lazy, gzip)",
      "path": "dist/controls-*.js",
      "limit": "10 kB",
      "gzip": true
    },
    {
      "name": "share dialog chunk (lazy, gzip)",
      "path": "dist/share-*.js",
      "limit": "6 kB",
      "gzip": true
    },
    {
      "name": "loading overlay chunk (lazy, gzip)",
      "path": "dist/loading-*.js",
      "limit": "3 kB",
      "gzip": true
    }
  ]
}
