{
    "name": "@zinejs/core",
    "version": "0.0.0",
    "description": "Framework-agnostic flipbook engine.",
    "type": "module",
    "sideEffects": false,
    "license": "PolyForm-Noncommercial-1.0.0",
    "files": ["dist", "options.schema.json"],
    "types": "./dist/index.d.ts",
    "module": "./dist/index.js",
    "main": "./dist/index.umd.cjs",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.umd.cjs"
      },
      "./options.schema.json": "./options.schema.json"
    },
    "scripts": {
        "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json",
        "test": "vitest run",
        "size": "pnpm build && size-limit"
    },
    "size-limit": [
      {
        "name": "core (ESM, gzip, excl. lazy renderer chunks)",
        "path": "dist/index.js",
        "limit": "15 kB",
        "gzip": true
      },
      {
        "name": "CSS renderer chunk (lazy, gzip)",
        "path": "dist/cssRenderer-*.js",
        "limit": "12 kB",
        "gzip": true
      }
    ]
  }