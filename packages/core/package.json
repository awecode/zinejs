{
  "name": "@zinejs/core",
  "version": "0.1.0",
  "description": "Framework-agnostic flipbook engine with CSS and WebGL2 renderers and no dependencies.",
  "type": "module",
  "sideEffects": false,
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": ["flipbook", "page-flip", "pageflip", "book", "webgl", "viewer", "zinejs"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awecode/zinejs.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/awecode/zinejs#readme",
  "bugs": "https://github.com/awecode/zinejs/issues",
  "files": ["dist", "options.schema.json"],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.umd.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./options.schema.json": "./options.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm typecheck && vitest run",
    "size": "pnpm build && size-limit",
    "prepublishOnly": "pnpm build"
  },
  "size-limit": [
    {
      "name": "core (ESM, gzip, excl. lazy renderer chunks)",
      "path": "dist/index.js",
      "limit": "15 kB",
      "gzip": true
    },
    {
      "name": "CSS renderer chunk (lazy, gzip)",
      "path": "dist/cssRenderer-*.js",
      "limit": "12 kB",
      "gzip": true
    },
    {
      "name": "WebGL2 renderer chunk (lazy, gzip)",
      "path": "dist/webglRenderer-*.js",
      "limit": "12 kB",
      "gzip": true
    }
  ]
}
