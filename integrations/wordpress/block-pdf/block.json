{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "zinejs/pdf-flipbook",
  "title": "Zine PDF Flipbook",
  "category": "media",
  "icon": "media-document",
  "description": "Turn a PDF into an interactive page-flip book.",
  "keywords": ["flipbook", "pdf", "book", "magazine", "zine"],
  "textdomain": "zinejs",
  "editorScript": "zinejs-block",
  "editorStyle": "zinejs",
  "attributes": {
    "url": { "type": "string", "default": "" },
    "frontCover": { "type": "string", "default": "" },
    "backCover": { "type": "string", "default": "" },
    "spreadMode": { "type": "string", "default": "cover" },
    "direction": { "type": "string", "default": "ltr" },
    "fit": { "type": "string", "default": "contain" },
    "responsiveSpread": { "type": "boolean", "default": true },
    "singlePageThreshold": { "type": "string", "default": "" },
    "maxWidth": { "type": "string", "default": "" },
    "aspect": { "type": "string", "default": "auto" },
    "clickToFlip": { "type": "string", "default": "edge" },
    "curl": { "type": "string", "default": "cone" },
    "flipDuration": { "type": "string", "default": "" },
    "startPage": { "type": "number", "default": 0 },
    "zoomEnabled": { "type": "boolean", "default": true },
    "zoomMax": { "type": "string", "default": "" },
    "zoomWheel": { "type": "boolean", "default": true },
    "zoomDoubleClick": { "type": "boolean", "default": true },
    "controls": { "type": "boolean", "default": true },
    "contextMenu": { "type": "boolean", "default": true },
    "loading": { "type": "boolean", "default": true },
    "hints": { "type": "boolean", "default": true },
    "deepLink": { "type": "boolean", "default": true },
    "allowDownload": { "type": "boolean", "default": true },
    "allowPrint": { "type": "boolean", "default": true },
    "allowShare": { "type": "boolean", "default": true }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  }
}
